rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /users/{uid}/questionReports/{rid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && rid.matches('^[a-f0-9-]{36}$')
        && request.resource.data.keys().hasAll(['questionId','kind','detail','createdAt','snapshotJSON','submittedAt'])
        && request.resource.data.keys().hasOnly(['questionId','kind','detail','createdAt','snapshotJSON','submittedAt'])
        && request.resource.data.questionId is string
        && request.resource.data.questionId.matches('^[0-9]{3}-[0-3]-[0-9]{1,2}$')
        && request.resource.data.kind in ['scan','answer','explanation','source','other']
        && request.resource.data.detail is string
        && request.resource.data.detail.size() > 0 && request.resource.data.detail.size() <= 2000
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40
        && request.resource.data.snapshotJSON is string && request.resource.data.snapshotJSON.size() <= 30000
        && request.resource.data.submittedAt == request.time;
      // Reports are immutable for clients. Only an authorized project operator may record a verified resolution.
    }
    match /users/{uid}/questions/{qid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && qid.matches('^[0-9]{3}-[0-3]-[0-9]{1,2}$')
        && request.resource.data.keys().hasOnly(['bookmark','explanationBookmark','note','record','wrong','history','applied','revision','updatedAt'])
        && (!('bookmark' in request.resource.data) || request.resource.data.bookmark is bool)
        && (!('explanationBookmark' in request.resource.data) || request.resource.data.explanationBookmark is bool)
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 10000))
        && (!('history' in request.resource.data) || (request.resource.data.history is list && request.resource.data.history.size() <= 500))
        && (!('record' in request.resource.data) || request.resource.data.record is map)
        && (!('wrong' in request.resource.data) || request.resource.data.wrong is map)
        && request.resource.data.applied is list && request.resource.data.applied.size() <= 128
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/study/session {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['sessionJSON','applied','revision','updatedAt'])
        && request.resource.data.sessionJSON is string && request.resource.data.sessionJSON.size() <= 200000
        && request.resource.data.applied is list && request.resource.data.applied.size() <= 128
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.updatedAt == request.time;
    }
  }
}
