rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /users/{uid}/questions/{qid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && qid.matches('^[0-9]{3}-[0-3]-[0-9]{1,2}$')
        && request.resource.data.keys().hasOnly(['bookmark','explanationBookmark','note','record','wrong','history','applied','revision','updatedAt'])
        && (!('bookmark' in request.resource.data) || request.resource.data.bookmark is bool)
        && (!('explanationBookmark' in request.resource.data) || request.resource.data.explanationBookmark is bool)
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 10000))
        && (!('history' in request.resource.data) || (request.resource.data.history is list && request.resource.data.history.size() <= 500))
        && (!('record' in request.resource.data) || request.resource.data.record is map)
        && (!('wrong' in request.resource.data) || request.resource.data.wrong is map)
        && request.resource.data.applied is list && request.resource.data.applied.size() <= 128
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/study/session {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['sessionJSON','applied','revision','updatedAt'])
        && request.resource.data.sessionJSON is string && request.resource.data.sessionJSON.size() <= 200000
        && request.resource.data.applied is list && request.resource.data.applied.size() <= 128
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.updatedAt == request.time;
    }
  }
}
