{
  "name": "statistics-exam-notebook",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/prepare-static.mjs && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "prebuild": "node scripts/prepare-static.mjs",
    "deploy": "npm run build && npx firebase-tools deploy --only firestore:rules,hosting --project library-exam-notebook",
    "brand:icons": "node scripts/prepare-brand-icons.mjs"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "next": "16.4.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0"
  }
}
